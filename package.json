{
  "name": "mulqi-superpowers",
  "version": "0.1.0",
  "description": "A DeepSeek Harness bundle that exposes obra/superpowers skills and injects the using-superpowers bootstrap.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "vendor/**"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mulqizamzam/mulqi-superpowers.git"
  },
  "homepage": "https://github.com/mulqizamzam/mulqi-superpowers",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check lib/index.js"
  },
  "dependencies": {
    "yaml": "^2.4.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3",
    "@deepseek-ai/dsh-skill": "workspace:^"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
