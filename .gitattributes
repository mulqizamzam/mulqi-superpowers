# Normalize every text file to LF in the index and in every checkout.
# Without this, a WSL/Windows checkout rewrites 43 tracked files to CRLF and
# `git status` reports phantom modifications that hide real edits.
* text=auto eol=lf

# Shell and script files must stay LF.
*.sh    text eol=lf
*.bash  text eol=lf
*.cjs   text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.dot   text eol=lf
*.cmd   text eol=lf

# Binary assets are never converted.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.tgz   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.mp4   binary
